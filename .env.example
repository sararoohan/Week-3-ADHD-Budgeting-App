# Environment variables template.
#
# HOW TO USE:
#   1. Copy this file to `.env.local`  ->  cp .env.example .env.local
#   2. Fill in the real values in `.env.local` (it is gitignored, never committed).
#   3. In production, set the same variables in Vercel -> Settings -> Environment Variables.
#
# This file lists variable NAMES only — never put real secrets here. See ADR-0006.

# --- Supabase: safe for the browser (NEXT_PUBLIC_ = exposed to the client) ---
# From Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: SERVER-ONLY (no NEXT_PUBLIC_ prefix; never use in a client component) ---
# Bypasses Row Level Security, so treat it like a master key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in ---
# The Google OAuth client ID + secret are configured in the Supabase dashboard
# (Authentication -> Providers -> Google), NOT as app env vars — so they are not
# listed here. Add app-side Google vars below only if the app ever needs them directly.
